@startuml workspace-scope-flow
title Workspace Scope Read/Write Flow (CP1)

skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #888888
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FAFAFA
skinparam sequenceGroupBorderColor #CCCCCC
skinparam sequenceGroupBodyBackgroundColor #FAFAFA

actor "Operator" as Op
participant "Dashboard" as UI #E0E7FF
participant "API\n(requireAuth)" as API #DBEAFE
database "TimescaleDB\nuser_workspaces" as DB #FEF9C3

Op -> UI : opens dashboard (already authenticated)
UI -> API : POST /users/me/workspace

alt role == demo
  API --> UI : 403 (no DB query made)
  UI -> Op : workspace controls hidden/disabled
else role == operator
  API -> DB : SELECT scope WHERE user_id = $jwt.user_id
  alt no row
    DB --> API : 0 rows
    API --> UI : 404 { error: "no_workspace" }
    UI -> Op : scope setup prompt (region, entity types, alert types)
    Op -> UI : submits initial scope
    UI -> API : PUT /users/me/workspace { geo_region, entity_types, alert_types }
    API -> API : validate bounds + subset checks
    alt invalid body
      API --> UI : 400 (no write)
    else valid
      API -> DB : INSERT ... ON CONFLICT (user_id) DO UPDATE
      DB --> API : row written
      API --> UI : 200 { scope }
    end
  else row exists
    DB --> API : scope JSONB
    API --> UI : 200 { scope }
    UI -> Op : map/alerts restored to saved scope
    Op -> UI : edits scope later
    UI -> API : PUT /users/me/workspace { ...updated scope }
    API -> API : validate bounds + subset checks
    API -> DB : INSERT ... ON CONFLICT (user_id) DO UPDATE
    DB --> API : row written
    API --> UI : 200 { scope }
  end
end

note over UI, API
  CP1 stops here: the scope is persisted and readable.
  Nothing yet filters GET /alerts or the WebSocket stream
  by this scope -- that is CP2/CP3. A saved scope with no
  enforcement is observable but not yet operationally meaningful.
end note

@enduml
