@startuml Sentinel Architecture

skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 110

skinparam backgroundColor #1e1e2e
skinparam defaultFontColor #cdd6f4
skinparam defaultFontName "Helvetica"
skinparam arrowThickness 2

skinparam node {
    BackgroundColor #181825
    BorderColor #45475a
    FontColor #cdd6f4
    FontStyle bold
}

skinparam component {
    BackgroundColor #313244
    BorderColor #585b70
    FontColor #cdd6f4
}

skinparam database {
    BackgroundColor #313244
    BorderColor #585b70
    FontColor #cdd6f4
}

skinparam queue {
    BackgroundColor #4c1d95
    BorderColor #7c3aed
    FontColor #e9d5ff
}

together {
    node "External Feeds" #1e3a2a {
        component [OpenSky Network\n(ADS-B · OAuth2)] as ADSB #2d5a3d
        component [AISHub\n(AIS)] as AIS #2d5a3d
    }

    node "Dev Tooling" #3a3a1a {
        component [Load Generator\n(synthetic anomaly injection)] as LOADGEN #5a5a1a
    }

    node "Identity Provider" #1a1a3a {
        component [Google OAuth 2.0\n(ID token verification)] as GOOGLE #2d2d5a
    }
}

node "Ingestion Layer" #1a2a3a {
    component [Ingestion Poller\n(per region)] as POLLER #1e3a5a
}

node "Message Broker" #2a1a3a {
    queue [adsb.raw  |  ais.raw] as KAFKA_RAW
    queue [position.normalized] as KAFKA_NORM
    queue [adsb.dlq  |  ais.dlq\n(dead-letter)] as KAFKA_DLQ #5a1a1a
    queue [deviation.candidates] as KAFKA_DEV_CAND
    queue [proximity.candidates] as KAFKA_PROX_CAND
    queue [alerts] as KAFKA_ALERTS
}

together {
    node "Position Consumer" #1a2a3a {
        component [normalise + persist\nTimescaleDB + Redis live state\nmaintain Redis H3 index] as POS_CONSUMER #1e3a5a
    }

    node "Correlation Worker" #1a2a3a {
        component [H3 candidate lookup + exact distance\nKNOWN_ASSOCIATE filtering\nNeo4j evidence + proximity.candidates] as CORR_WORKER #1e3a5a
    }

    node "Deviation Detector" #1a2a3a {
        component [reference route comparison\nstateless · deviation.candidates publisher] as DEV_DETECTOR #1e3a5a
    }
}

together {
    node "TimescaleDB" #0c2a3a {
        database [position history · alerts\nroute_references · users · workspaces\ntime-partitioned by observed_at\ngeo_cell = indexed query column] as TSDB #0c4a6e
    }

    node "Neo4j" #0a2a1a {
        database [entity graph\nPROXIMITY_EVENT evidence\nKNOWN_ASSOCIATE relationships] as NEO4J #14532d
    }

    node "Redis" #3a0a0a {
        database [live entity state + H3 live index\nleader election + anomaly episode state\nposition-updates + alert-events pub/sub] as REDIS #7f1d1d
    }
}

node "Alert Layer" #2a1a3a {
    component [Alert Evaluator\n(leader-elected · hybrid inputs)\nsignal loss via Redis scan\nroute deviation + proximity via Kafka\ncomposite via Redis loss state] as ALERT #4c1d95
}

node "API Layer" #1a2a3a {
    component [Dashboard API\nREST + WebSocket\nalert persistence + lifecycle + scope] as API #1e3a5a
}

node "Dashboard" #1e3a2a {
    component [Angular + Leaflet\nLive Map + Alert Feed + Investigation] as DASH #2d5a3d
}

ADSB        -[#4ade80]down->  POLLER
AIS         -[#4ade80]down->  POLLER
LOADGEN     -[#facc15]down->  KAFKA_RAW
POLLER      -[#facc15]down->  KAFKA_RAW

KAFKA_RAW   -[#a78bfa]down->  POS_CONSUMER
POS_CONSUMER -[#f87171]right-> KAFKA_DLQ
POS_CONSUMER -[#38bdf8]down-> TSDB
POS_CONSUMER -[#f87171]down-> REDIS
POS_CONSUMER -[#a78bfa]right-> KAFKA_NORM

KAFKA_NORM  -[#a78bfa]down->  CORR_WORKER
KAFKA_NORM  -[#a78bfa]down->  DEV_DETECTOR

CORR_WORKER  -[#f87171]down-> REDIS : "live H3 + positions"
CORR_WORKER  -[#4ade80]down-> NEO4J : "KNOWN_ASSOCIATE check\n+ PROXIMITY_EVENT evidence"
CORR_WORKER  -[#a78bfa]down-> KAFKA_PROX_CAND : "unscheduled pairs only"

DEV_DETECTOR -[#38bdf8]down-> TSDB : "reference routes"
DEV_DETECTOR -[#a78bfa]down-> KAFKA_DEV_CAND

KAFKA_DEV_CAND  -[#a78bfa]down-> ALERT
KAFKA_PROX_CAND -[#a78bfa]down-> ALERT
REDIS       <-[#fb923c]-> ALERT : "live scan / episode state / lease"
TSDB        -[#fb923c]-> ALERT : "last known position\n(signal loss payload only)"

ALERT        -[#94a3b8]down-> KAFKA_ALERTS
KAFKA_ALERTS -[#94a3b8]down-> API

API         -[#38bdf8]left-> TSDB
API         <-[#f87171]-> REDIS : "live state / pub-sub"
API         -[#4ade80]left-> NEO4J : "investigation only"
API         -[#a78bfa]up-> GOOGLE
API         -[#94a3b8]down-> DASH

note right of ALERT
  Alert Evaluator does NOT query Neo4j.
  proximity.candidates is already filtered
  by the Correlation Worker.
end note

note right of KAFKA_ALERTS
  Transport is at-least-once.
  Deterministic alert_id + DB constraints
  provide idempotent durable effects.
end note

@enduml
