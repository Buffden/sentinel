@startuml Sentinel Architecture

skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 110

skinparam backgroundColor #1e1e2e
skinparam defaultFontColor #cdd6f4
skinparam defaultFontName "Helvetica"
skinparam arrowThickness 2

skinparam node {
    BackgroundColor #181825
    BorderColor #45475a
    FontColor #cdd6f4
    FontStyle bold
}

skinparam component {
    BackgroundColor #313244
    BorderColor #585b70
    FontColor #cdd6f4
}

skinparam database {
    BackgroundColor #313244
    BorderColor #585b70
    FontColor #cdd6f4
}

skinparam queue {
    BackgroundColor #4c1d95
    BorderColor #7c3aed
    FontColor #e9d5ff
}

node "External Feeds" #1e3a2a {
    component [OpenSky Network\n(ADS-B)] as ADSB #2d5a3d
    component [AISHub\n(AIS)] as AIS #2d5a3d
}

node "Dev Tooling" #3a3a1a {
    component [Load Generator\n(synthetic anomaly injection)] as LOADGEN #5a5a1a
}

node "Identity Provider" #1a1a3a {
    component [Google OAuth 2.0\n(ID token verification)] as GOOGLE #2d2d5a
}

node "Ingestion Layer" #1a2a3a {
    component [Ingestion Poller] as POLLER #1e3a5a
}

node "Message Broker" #2a1a3a {
    queue [adsb.raw | ais.raw] as KAFKA_RAW
    queue [position.normalized] as KAFKA_NORM
    queue [adsb.dlq | ais.dlq] as KAFKA_DLQ #5a1a1a
    queue [deviation.candidates] as KAFKA_DEV
    queue [proximity.candidates] as KAFKA_PROX
    queue [alerts] as KAFKA_ALERTS
}

together {
    node "Position Consumer" #1a2a3a {
        component [normalise + history + live state\nH3 history/live cells] as POS #1e3a5a
    }

    node "Deviation Detector" #1a2a3a {
        component [stateless reference-route\nclassification] as DEV #1e3a5a
    }

    node "Correlation Worker" #1a2a3a {
        component [H3 candidate lookup + exact distance\nKNOWN_ASSOCIATE filter + graph evidence] as CORR #1e3a5a
    }
}

together {
    node "TimescaleDB" #0c2a3a {
        database [position_history · alerts\nroute_references · route_reference_points\nusers · user_workspaces\ntime partition: observed_at\ngeo_cell: indexed column] as TSDB #0c4a6e
    }

    node "Redis" #3a0a0a {
        database [entity:live:{id}\ngeo-cell:{h3} sorted sets\nalert-state / recent-loss\ndeviation-state / proximity-episode\nleader lease\nposition-updates / alert-events] as REDIS #7f1d1d
    }

    node "Neo4j" #0a2a1a {
        database [Entity\nPROXIMITY_EVENT\nKNOWN_ASSOCIATE] as NEO4J #14532d
    }
}

node "Alert Layer" #2a1a3a {
    component [Alert Evaluator\nleader-elected · hybrid inputs\nsignal loss via Redis scan\nroute deviation via Kafka\nproximity/composite via Kafka + Redis] as ALERT #4c1d95
}

node "API Layer" #1a2a3a {
    component [Dashboard API\nREST + WebSocket] as API #1e3a5a
}

node "Dashboard" #1e3a2a {
    component [Angular + Leaflet\nLive Map + Alert Feed + Investigation] as DASH #2d5a3d
}

ADSB -[#4ade80]down-> POLLER
AIS -[#4ade80]down-> POLLER
LOADGEN -[#facc15]down-> KAFKA_RAW
POLLER -[#facc15]down-> KAFKA_RAW

KAFKA_RAW -[#a78bfa]down-> POS
POS -[#f87171]right-> KAFKA_DLQ
POS -[#38bdf8]down-> TSDB
POS -[#f87171]down-> REDIS
POS -[#a78bfa]right-> KAFKA_NORM

KAFKA_NORM -[#a78bfa]down-> DEV
KAFKA_NORM -[#a78bfa]down-> CORR

DEV -[#38bdf8]down-> TSDB : "reference routes"
DEV -[#a78bfa]down-> KAFKA_DEV

CORR -[#f87171]down-> REDIS : "live/H3 state"
CORR <-[#4ade80]-> NEO4J : "KNOWN_ASSOCIATE read\nPROXIMITY_EVENT write"
CORR -[#a78bfa]down-> KAFKA_PROX

KAFKA_DEV -[#a78bfa]down-> ALERT
KAFKA_PROX -[#a78bfa]down-> ALERT
REDIS <-[#fb923c]-> ALERT : "signal-loss +\nepisode state"
TSDB -[#fb923c]-> ALERT : "last-known position\n(signal loss payload only)"

note right of ALERT
  No direct Neo4j dependency.
  KNOWN_ASSOCIATE filtering is owned
  by the Correlation Worker before
  proximity.candidates is published.
end note

ALERT -[#94a3b8]down-> KAFKA_ALERTS
KAFKA_ALERTS -[#94a3b8]down-> API

API -[#38bdf8]left-> TSDB
API <-[#f87171]-> REDIS : "live state + pub/sub"
API -[#4ade80]left-> NEO4J : "investigation evidence"
API -[#a78bfa]up-> GOOGLE
API -[#94a3b8]down-> DASH

note bottom of KAFKA_ALERTS
  Kafka processing: at-least-once.
  Durable alert rows: idempotent / exactly-once effect.
  WebSocket delivery: at-least-once; client dedupe required.
end note

@enduml
