@startuml Sentinel Architecture

skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 110

skinparam backgroundColor #1e1e2e
skinparam defaultFontColor #cdd6f4
skinparam defaultFontName "Helvetica"
skinparam arrowThickness 2

skinparam node {
    BackgroundColor #181825
    BorderColor #45475a
    FontColor #cdd6f4
    FontStyle bold
}

skinparam component {
    BackgroundColor #313244
    BorderColor #585b70
    FontColor #cdd6f4
}

skinparam database {
    BackgroundColor #313244
    BorderColor #585b70
    FontColor #cdd6f4
}

skinparam queue {
    BackgroundColor #4c1d95
    BorderColor #7c3aed
    FontColor #e9d5ff
}

' --- Row 1: External Feeds ---
together {
    node "External Feeds" #1e3a2a {
        component [OpenSky Network\n(ADS-B · OAuth2)] as ADSB #2d5a3d
        component [AISHub\n(AIS)] as AIS #2d5a3d
    }

    node "Dev Tooling" #3a3a1a {
        component [Load Generator\n(synthetic anomaly injection)] as LOADGEN #5a5a1a
    }

    node "Identity Provider" #1a1a3a {
        component [Google OAuth 2.0\n(ID token verification)] as GOOGLE #2d2d5a
    }
}

' --- Row 2: Ingestion ---
node "Ingestion Layer" #1a2a3a {
    component [Ingestion Poller\n(per region)] as POLLER #1e3a5a
}

' --- Row 3: Message Broker ---
node "Message Broker" #2a1a3a {
    queue [adsb.raw  |  ais.raw] as KAFKA_RAW
    queue [position.normalized] as KAFKA_NORM
    queue [adsb.dlq  |  ais.dlq\n(dead-letter)] as KAFKA_DLQ #5a1a1a
    queue [deviation.candidates] as KAFKA_DEV_CAND
    queue [proximity.candidates] as KAFKA_PROX_CAND
    queue [alerts] as KAFKA_ALERTS
}

' --- Row 4: Processing ---
together {
    node "Position Consumer" #1a2a3a {
        component [normalise + write\nto TimescaleDB + Redis] as POS_CONSUMER #1e3a5a
    }

    node "Correlation Worker" #1a2a3a {
        component [proximity detection\nentity graph + proximity.candidates] as CORR_WORKER #1e3a5a
    }

    node "Deviation Detector" #1a2a3a {
        component [reference route comparison\nstateless · deviation.candidates publisher] as DEV_DETECTOR #1e3a5a
    }
}

' --- Row 5: Persistence ---
together {
    node "TimescaleDB" #0c2a3a {
        database [position history · alerts\nroute_references · users · workspaces\ntime-partitioned by observed_at\ngeo_cell: index column (not partition)] as TSDB #0c4a6e
    }

    node "Neo4j" #0a2a1a {
        database [entity graph\nproximity episodes (PROXIMITY_EVENT edges)\nknown associates (KNOWN_ASSOCIATE edges)] as NEO4J #14532d
    }

    node "Redis" #3a0a0a {
        database [live entity state · leader election\nentity:live:{id} · alert-state:{id} (hash)\nrecent-loss:{id} · proximity-episode:{pair}\ndeviation-state:{id}\npub/sub: position-updates · alert-events] as REDIS #7f1d1d
    }
}

' --- Row 6: Alert ---
node "Alert Layer" #2a1a3a {
    component [Alert Evaluator\n(leader-elected · hybrid inputs)\nsignal-loss via Redis scan\ndeviation + proximity via Kafka\ncomposite via supersession] as ALERT #4c1d95
}

' --- Row 7: API ---
node "API Layer" #1a2a3a {
    component [Dashboard API\nREST  +  WebSocket] as API #1e3a5a
}

' --- Row 8: Dashboard ---
node "Dashboard" #1e3a2a {
    component [Angular + Leaflet\nLive Map  +  Alert Feed] as DASH #2d5a3d
}

' --- Connections ---

' feeds -> poller (green)
ADSB        -[#4ade80]down->  POLLER
AIS         -[#4ade80]down->  POLLER

' load generator -> raw topics directly (yellow)
LOADGEN     -[#facc15]down->  KAFKA_RAW

' poller -> raw topics (yellow)
POLLER      -[#facc15]down->  KAFKA_RAW

' broker: raw -> position consumer (purple)
KAFKA_RAW   -[#a78bfa]down->  POS_CONSUMER

' consumers -> DLQ on malformed event (red)
POS_CONSUMER -[#f87171]right-> KAFKA_DLQ

' position consumer -> persistence
POS_CONSUMER -[#38bdf8]down-> TSDB
POS_CONSUMER -[#f87171]down-> REDIS

' position consumer -> normalized topic (for correlation worker + deviation detector)
POS_CONSUMER -[#a78bfa]right-> KAFKA_NORM

' normalized -> correlation worker + deviation detector
KAFKA_NORM  -[#a78bfa]down->  CORR_WORKER
KAFKA_NORM  -[#a78bfa]down->  DEV_DETECTOR

' correlation worker reads live positions from Redis
CORR_WORKER  -[#f87171]down-> REDIS

' correlation worker -> Neo4j (write proximity edges) + proximity.candidates
CORR_WORKER  -[#4ade80]down-> NEO4J
CORR_WORKER  -[#a78bfa]down-> KAFKA_PROX_CAND

' deviation detector reads route_reference_points from TimescaleDB
DEV_DETECTOR -[#38bdf8]down-> TSDB

' deviation detector -> deviation.candidates
DEV_DETECTOR -[#a78bfa]down-> KAFKA_DEV_CAND

' deviation.candidates + proximity.candidates -> alert evaluator (purple, Kafka-sourced inputs)
KAFKA_DEV_CAND  -[#a78bfa]down-> ALERT
KAFKA_PROX_CAND -[#a78bfa]down-> ALERT

' alert evaluator: reads + writes Redis; reads TimescaleDB (last known position) and Neo4j (composite context)
REDIS       <-[#fb923c]->     ALERT : "reads / writes"
TSDB        -[#fb923c]->      ALERT : "reads\n(last known position)"
NEO4J       -[#fb923c]down->  ALERT : "reads\n(composite context)"

' alert evaluator -> alerts topic -> API (slate)
ALERT       -[#94a3b8]down->  KAFKA_ALERTS
KAFKA_ALERTS -[#94a3b8]down-> API

' API reads from stores and verifies identity with Google
API         -[#38bdf8]left->  TSDB
API         <-[#f87171]->     REDIS : "entity state /\nposition-updates /\nalert-events"
API         -[#4ade80]left->  NEO4J
API         -[#a78bfa]up->    GOOGLE

' API -> dashboard
API         -[#94a3b8]down->  DASH

@enduml
