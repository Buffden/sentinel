    {
      "id": "note-api-sink",
      "type": "text",
      "x": -719.2948934130886,
      "y": 1370.3012123040876,
      "width": 349.44000000000005,
      "height": 80,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 669341326,
      "version": 102,
      "versionNonce": 1262207226,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791140904320,
      "link": null,
      "locked": false,
      "text": "Alert sink: idempotent DB transaction\n→ Redis alert-events → offset commit.\nPub/sub fans out to all API instances.\nWorkspace scope + client deduplication.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Alert sink: idempotent DB transaction\n→ Redis alert-events → offset commit.\nPub/sub fans out to all API instances.\nWorkspace scope + client deduplication.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1B"
    },
    {
      "id": "note-coordinator",
      "type": "text",
      "x": -700.1443891085486,
      "y": -619.8411719805966,
      "width": 384.0956726074219,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 256150965,
      "version": 7,
      "versionNonce": 455016294,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791139153945,
      "link": null,
      "locked": false,
      "text": "One authoritative ADS-B provider.\nHealth, authority and coverage are separate.\nPublish before authority / coverage writes.\nFailback: adsb.fi HEALTHY + 5 min on OpenSky.\nLease guards instances; it does not fence Kafka.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One authoritative ADS-B provider.\nHealth, authority and coverage are separate.\nPublish before authority / coverage writes.\nFailback: adsb.fi HEALTHY + 5 min on OpenSky.\nLease guards instances; it does not fence Kafka.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1C"
    },
    {
      "id": "note-signal-loss",
      "type": "text",
      "x": -270.43812125804044,
      "y": 1380.5252609088932,
      "width": 456.96000000000004,
      "height": 80,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 804355169,
      "version": 108,
      "versionNonce": 894049978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791140909383,
      "link": null,
      "locked": false,
      "text": "SIGNAL_LOSS counts the entity owner’s provider\ncoverage since last_seen_ms. Downtime adds nothing.\nMissing / unreadable timeline skips signal loss.\nEvaluator has no TimescaleDB or Neo4j dependency.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SIGNAL_LOSS counts the entity owner’s provider\ncoverage since last_seen_ms. Downtime adds nothing.\nMissing / unreadable timeline skips signal loss.\nEvaluator has no TimescaleDB or Neo4j dependency.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1D"
    },
    {
      "id": "legend-status",
      "type": "text",
      "x": -719.8713369069384,
      "y": 1527.4639237473152,
      "width": 618.24,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 391820728,
      "version": 71,
      "versionNonce": 2106355066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791140906961,
      "link": null,
      "locked": false,
      "text": "Solid arrows: implemented paths. Dashed arrows: planned paths.\nReference-route tables belong to the planned deviation path.\nCP4: structured JSON logs across all five backend services.\nCP5: bounded datastore /healthz checks; Kafka health is out of scope.\nCP6: make lag reads committed offsets and broker log ends via rpk.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solid arrows: implemented paths. Dashed arrows: planned paths.\nReference-route tables belong to the planned deviation path.\nCP4: structured JSON logs across all five backend services.\nCP5: bounded datastore /healthz checks; Kafka health is out of scope.\nCP6: make lag reads committed offsets and broker log ends via rpk.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b1E"
    },
