@startuml write-path
title US-01: Write Path - Accepted Position Updates History + Monotonic Live State

skinparam sequenceArrowThickness 1.5
skinparam participantBorderColor #555555
skinparam participantBackgroundColor #F8F8F8
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7

collections "OpenSky / AIS\nFeed" as Feed
participant "Ingestion\nPoller" as Poller
queue "Kafka\nadsb.raw / ais.raw" as KafkaRaw
participant "Position\nConsumer" as Consumer
database "Redis\nentity:live:{id}" as LiveState
database "Redis\ngeo-cell:{cell}\n(sorted set)" as GeoCell
database "TimescaleDB\nposition_history" as TSDB
database "Redis\nposition-updates\n(pub/sub)" as PositionUpdates
queue "Kafka\nposition.normalized" as KafkaNorm

Feed -> Poller : source position record
Poller -> KafkaRaw : publish raw record
KafkaRaw -> Consumer : consume at-least-once

Consumer -> Consumer : normalize + validate\ncompute history_geo_cell + live_geo_cell
Consumer -> LiveState : HGET last_seen_ms, live_geo_cell
LiveState --> Consumer : stored state or nil

alt incoming timestamp older than stored last_seen_ms
  Consumer -> Consumer : skip live-state/geo-cell regression
else accepted current event
  alt previous live_geo_cell exists AND changed
    Consumer -> GeoCell : ZREM geo-cell:{old_cell} entity_id
  end
  Consumer -> GeoCell : ZADD geo-cell:{live_geo_cell}\nscore=timestamp_ms member=entity_id
  Consumer -> LiveState : HSET latest fields + last_seen_ms + live_geo_cell\nrefresh 24h safety TTL
  Consumer -> PositionUpdates : PUBLISH accepted live position update
end

Consumer -> TSDB : INSERT position_history\nON CONFLICT (entity_id, observed_at) DO NOTHING

note over TSDB
  observed_at is the time partition column.
  history geo_cell is an indexed column,
  not a TimescaleDB partition dimension.
end note

Consumer -> KafkaNorm : publish canonical position.normalized\n{ history_geo_cell, live_geo_cell, ... }

note over LiveState
  24h TTL is a safety net only.
  Signal-loss detection and dashboard staleness
  use last_seen_ms, not TTL expiry.
end note

@enduml
