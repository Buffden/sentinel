@startuml deviation-detection
title US-04: Deviation Detection - Detector classifies each ping; Evaluator owns episode state

skinparam sequenceArrowThickness 1.5
skinparam participantBorderColor #555555
skinparam participantBackgroundColor #F8F8F8
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7

queue "Kafka\nposition.normalized" as NormKafka
participant "Deviation\nDetector" as Detector
database "TimescaleDB\nroute_references +\nroute_reference_points" as RoutePoints
queue "Kafka\ndeviation.candidates" as DevCandKafka
participant "Alert\nEvaluator\n(leader)" as Evaluator
database "Redis\ndeviation-state:{id}" as DevState
queue "Kafka\nalerts" as Alerts
participant "Express API" as API
database "TimescaleDB\nalerts" as TSDB
participant "Angular\nDashboard" as Dashboard
actor Operator

NormKafka -> Detector : consume position event\n{ entity_id, lat, lon, timestamp_ms, ... }

Detector -> RoutePoints : look up assigned reference route for entity
RoutePoints --> Detector : waypoint list + corridor_threshold_metres\n(or empty if no reference route)

alt no reference route found
  Detector -> Detector : skip — entity has no assigned route\nno event published (real ADS-B/AIS in v1)
end

Detector -> Detector : for each segment (waypoint[i] → waypoint[i+1]):\ncompute minimum perpendicular distance\nidentify nearest segment index

alt deviation_metres > corridor_threshold_metres
  Detector -> DevCandKafka : publish OUT_OF_RANGE\n{ entity_id, timestamp_ms, status: OUT_OF_RANGE,\n  current_position, deviation_metres,\n  nearest_segment_index }
else within threshold
  Detector -> DevCandKafka : publish IN_RANGE\n{ entity_id, timestamp_ms, status: IN_RANGE,\n  current_position }
end

note over Detector
  Stateless: classifies every eligible ping independently.
  No counter, no alert suppression.
  Episode state belongs entirely to the Alert Evaluator.
end note

DevCandKafka -> Evaluator : consume deviation.candidates event

Evaluator -> DevState : check last_processed_ms (replay guard)
DevState --> Evaluator : stored value or nil

alt event.timestamp_ms <= last_processed_ms
  Evaluator -> Evaluator : skip — out-of-order or duplicate replay
end

alt status = OUT_OF_RANGE
  Evaluator -> DevState : increment count; update last_processed_ms;\nset episode_start_ms on first OUT_OF_RANGE;\nrefresh safety TTL (DEVIATION_STATE_TTL_MS)
  DevState --> Evaluator : updated count

  alt count >= DEVIATION_SUSTAINED_PINGS AND alert_emitted == 0
    Evaluator -> Alerts : publish ROUTE_DEVIATION alert\n{ alert_id, entity_id, current_position,\n  deviation_metres, nearest_segment_index,\n  sustained_cycles, episode_start_ms }

    note over Evaluator
      alert_emitted set to 1 after emission.
      Subsequent OUT_OF_RANGE pings within the same
      episode increment count but do not re-emit.
      One alert per deviation episode.
    end note

    Alerts -> API : consume alert
    API -> TSDB : persist alert (idempotent on replay)
    API --> Dashboard : push alert over WebSocket\n(scope-matched connections only)
    Dashboard --> Operator : route deviation alert displayed
  else count < DEVIATION_SUSTAINED_PINGS or already emitted
    Evaluator -> Evaluator : no alert — threshold not crossed\nor already emitted for this episode
  end

else status = IN_RANGE
  Evaluator -> DevState : DEL deviation-state:{entity_id}
  note over Evaluator
    Episode reset. No alert emitted on IN_RANGE.
    Next OUT_OF_RANGE starts a new episode.
  end note
end

@enduml
