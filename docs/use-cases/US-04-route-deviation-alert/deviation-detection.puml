@startuml deviation-detection
title US-04: Deviation Detection - Deviation Detector publishes candidates, Alert Evaluator emits alert

skinparam sequenceArrowThickness 1.5
skinparam participantBorderColor #555555
skinparam participantBackgroundColor #F8F8F8
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7

queue "Kafka\nposition.normalized" as NormKafka
participant "Deviation\nDetector" as Detector
database "TimescaleDB\nroute_reference_points" as RoutePoints
queue "Kafka\ndeviation.candidates" as DevCandKafka
participant "Alert\nEvaluator\n(leader)" as Evaluator
database "Redis\ndeviation-state:{id}\n(hash)" as DevState
queue "Kafka\nalerts" as Alerts
participant "Express API" as API
database "TimescaleDB\nalerts table" as TSDB
participant "Angular\nDashboard" as Dashboard
actor Operator

NormKafka -> Detector : consume position event\n{ entity_id, lat, lon, timestamp_ms }

Detector -> RoutePoints : SELECT sequence_index, lat, lon, tolerance_metres\nFROM route_reference_points\nJOIN route_references USING (route_id)\nWHERE entity_id = $entity_id
RoutePoints --> Detector : ordered waypoint list\n(or empty if no reference route)

alt no reference route found
  Detector -> Detector : skip — entity has no reference route\nno event published
end

Detector -> Detector : find nearest waypoint\ncompute Haversine distance to each waypoint

alt distance to nearest > waypoint.tolerance_metres
  Detector -> DevCandKafka : publish OUT_OF_RANGE\n{ entity_id, timestamp_ms, status: OUT_OF_RANGE,\n  current_position, deviation_metres,\n  nearest_waypoint_index }
else within threshold
  Detector -> DevCandKafka : publish IN_RANGE\n{ entity_id, timestamp_ms, status: IN_RANGE,\n  current_position }
end

note over Detector
  Stateless: no counter, no alert suppression.
  Detector owns comparison only.
  Counter and alert emission belong
  to the Alert Evaluator (ADR-014).
end note

DevCandKafka -> Evaluator : consume deviation.candidates event

note over Evaluator
  Replay guard: check last_processed_ms in deviation-state hash.
  If event.timestamp_ms <= last_processed_ms: skip (out-of-order replay).
end note

Evaluator -> DevState : HGET deviation-state:{entity_id} last_processed_ms
DevState --> Evaluator : $last_processed_ms (or nil)

alt event.timestamp_ms <= last_processed_ms
  Evaluator -> Evaluator : skip — out-of-order or duplicate replay
end

alt status = OUT_OF_RANGE
  Evaluator -> DevState : HINCRBY deviation-state:{entity_id} count 1\nHSET last_processed_ms $timestamp_ms\n(HSET episode_start_ms $timestamp_ms ON FIRST increment)
  DevState --> Evaluator : updated count

  Evaluator -> DevState : EXPIRE deviation-state:{entity_id}\n2 × SIGNAL_LOSS_THRESHOLD_MS

  alt count >= DEVIATION_SUSTAINED_PINGS
    Evaluator -> Alerts : publish to alerts\n{ alert_id, alert_type: ROUTE_DEVIATION, entity_id,\n  current_position, deviation_metres,\n  nearest_waypoint_index, sustained_cycles,\n  episode_start_ms }
    Alerts -> API : consume alert
    API -> TSDB : INSERT INTO alerts\n( alert_id, entity_id, alert_type: ROUTE_DEVIATION,\n  status: NEW, detected_at, payload )\nON CONFLICT (alert_id) DO NOTHING
    note over API
      Idempotent write - safe under Kafka replay.
      Scope filter applied before push:
      entity position + type must match
      the operator's saved workspace scope.
    end note
    API --> Dashboard : push alert over WebSocket\n(scope-matched connections only)
    Dashboard --> Operator : route deviation alert displayed\nstatus: NEW
  else count < DEVIATION_SUSTAINED_PINGS
    Evaluator -> Evaluator : no alert yet - transient deviation
  end

else status = IN_RANGE
  Evaluator -> DevState : DEL deviation-state:{entity_id}
  note over Evaluator
    State reset.
    No alert emitted on IN_RANGE.
  end note
end

@enduml
